    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst sessionId = data.session_id;\nconst generationDate = data.GenerationDate;\nconst companyDB = data.company_db;\nconst clientId = data.client_id;\n\n// Crear objetos de fecha\nconst generationDateObj = new Date(generationDate);\n// Calcular expiración (Service Layer expira en 30 min por defecto)\nconst expirationDateObj = new Date(generationDateObj.getTime() + 30 * 60 * 1000);\n\n// Formatear ambas fechas al horario de Bogotá\nconst formattedGenerationDate = generationDateObj.toLocaleString(\"sv-SE\", { timeZone: \"America/Bogota\" }).replace(\" \", \"T\") + \"-05:00\";\nconst formattedExpirationDate = expirationDateObj.toLocaleString(\"sv-SE\", { timeZone: \"America/Bogota\" }).replace(\" \", \"T\") + \"-05:00\";\n\nreturn {\n  json: {\n    clientId,\n    sessionId,\n    companyDB,\n    generationDate: formattedGenerationDate,\n    expirationDate: formattedExpirationDate,\n    isExpired: new Date() > expirationDateObj,\n    remainingMinutes: Math.max(0, Math.floor((expirationDateObj - new Date()) / (60 * 1000)))\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -192,
        -160
